{
  "name": "@frenchexdev2/result-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pwsh -NoProfile -File scripts/Invoke-Validation.ps1",
    "test:mutation": "pwsh -NoProfile -File scripts/Invoke-Validation.ps1 -Phase Mutation",
    "test:ci": "pnpm run typecheck && pnpm -r run test",
    "test:release": "node --test test/release.test.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Stéphane Erard <stephane.erard@gmail.com> (https://serard.dev)",
  "devDependencies": {
    "@typescript/native": "catalog:"
  }
}
